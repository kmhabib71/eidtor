# Application
DEBUG=False
SECRET_KEY=your-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_URL=http://localhost:3000

# Storage
STORAGE_TYPE=local  # Options: local, s3, gcs
STATIC_FILES_DIR=static
TEMP_DIR=temp

# File uploads
MAX_UPLOAD_SIZE_MB=500

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=silence_cutter

# AWS S3 (only needed if STORAGE_TYPE=s3)
S3_BUCKET_NAME=silence-cutter
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Google Cloud Storage (only needed if STORAGE_TYPE=gcs)
GCS_BUCKET_NAME=silence-cutter
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Silence detection settings
SILENCE_THRESHOLD_DB=-40
MIN_SILENCE_DURATION_MS=500

# Redis/Celery
REDIS_URL=redis://localhost:6379/0

# Stripe
STRIPE_API_KEY=your-stripe-api-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret 